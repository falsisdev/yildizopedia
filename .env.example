# ==============================================================================
# YILDIZOPEDIA TELEGRAM BOTU & RAG ÇEVRE DEĞİŞKENLERİ ŞABLONU
# ==============================================================================
# Bu dosyayı .env adıyla kopyalayın ve kendi anahtarlarınızla doldurun:
# cp .env.example .env

# 1. Telegram Bot Token (@BotFather'dan alınan token)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Yönetici Telegram ID (@userinfobot'tan öğrenilen sayısal ID)
ADMIN_TELEGRAM_ID=your_numeric_telegram_id_here

# 3. Groq Cloud API Key (https://console.groq.com - Ücretsiz 14.400 İstek/Gün)
# Anahtarınız henüz yoksa veya geçersizse sistem otomatik olarak Gemini'ye geçer.
GROQ_API_KEY=gsk_placeholder_replace_with_real_key

# 4. Google AI Studio API Key (https://aistudio.google.com - Ücretsiz 1.500 İstek/Gün)
GEMINI_API_KEY=your_gemini_api_key_here

# 5. Kullanıcı Başına Günlük Soru Limiti (Varsayılan: 15)
DAILY_QUESTION_LIMIT=15

# 6. Bilgi Bankası ve Veritabanı Yolları
KNOWLEDGE_BASE_DIR=.
SQLITE_DB_PATH=var/bot_data.sqlite3
